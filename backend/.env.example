PORT=3000
NODE_ENV=production
# Public URL of the deployed frontend, no trailing slash.
FRONTEND_URL=https://YOUR-GITHUB-PAGES-DOMAIN
# Public URL of this backend, no trailing slash.
API_PUBLIC_URL=https://YOUR-BACKEND-DOMAIN
# Discord Developer Portal > OAuth2 > Client ID and Client Secret
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_APPLICATION_CLIENT_SECRET
# Must exactly equal API_PUBLIC_URL + /auth/discord/callback
DISCORD_REDIRECT_URI=https://YOUR-BACKEND-DOMAIN/auth/discord/callback
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN
DISCORD_GUILD_ID=1538727238290251886
# Only these roles can use the admin dashboard. Defaults: Founder and SHR.
ADMIN_ROLE_IDS=1538727238483050664,1538727238441369677
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_PATH=./data/arp.sqlite
